# CodexSecure API — environment variables (names only; set real values in Coolify)
# Never commit a filled-in copy of this file.

# ---------------------------------------------------------------------------
# Server (the Docker image already defaults to these)
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8084
ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
# Set to true to also mount /, /health, /ready and /metrics (metrics is unauthenticated).
ENABLE_WEB_ROUTES=false

# ---------------------------------------------------------------------------
# Database — codex_zones PostgreSQL (REQUIRED; startup fails without DB_USER/DB_PASSWORD)
# Schema/migrations are owned by Web3Codex and must already be applied.
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=5432
DB_NAME=codex_zones
DB_USER=
DB_PASSWORD=
DB_SSL_MODE=require
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ---------------------------------------------------------------------------
# Communication channels / gateway (C6+)
# SERVICE_API_KEY is REQUIRED in production: if empty, ServiceKeyMiddleware lets requests through.
# CODEXSECURE_GATEWAY_ASSERTION_KEYS format: <kid>:<base64url Ed25519 public x>[,<kid>:<x>]
# ---------------------------------------------------------------------------
SERVICE_API_KEY=
CODEXSECURE_GATEWAY_ASSERTION_KEYS=
COMMUNICATION_SNAPSHOT_TTL_SECONDS=

# ---------------------------------------------------------------------------
# CodexHash integration
# ---------------------------------------------------------------------------
CODEXHASH_API_URL=
CODEXHASH_ENABLED=true
CODEXHASH_FAIL_OPEN=true
CODEXHASH_TIMEOUT_SEC=3

# ---------------------------------------------------------------------------
# CodexTime integration
# ---------------------------------------------------------------------------
CODEXTIME_API_URL=
CODEXTIME_ENABLED=true
CODEXTIME_FAIL_OPEN=true
CODEXTIME_TIMEOUT_SEC=3

# Signed TIU tokens (optional)
TIU_HMAC_SECRET=
TIU_MAX_DRIFT_SECONDS=15
TIU_MAX_FUTURE_SKEW_SECONDS=2

# ---------------------------------------------------------------------------
# Server Sevenfold pipeline — Stage 7 recording token
# (CODEX_STAGE7_API_TOKEN is accepted as an alias)
# ---------------------------------------------------------------------------
PIPELINE_API_TOKEN=

# ---------------------------------------------------------------------------
# Zones / pattern engine
# ---------------------------------------------------------------------------
# RESERVED / CURRENTLY UNUSED
# These settings are loaded by the Go configuration
# but have no runtime consumers as of November 2026.
# Preserved for future CodexZone development.
# Do not reactivate without verifying their implementation.
#
# ZONE_ROUTER_ID is also scheduled to be renamed
# to BOUNDARY_ID when boundary configuration is implemented.
#
# ZONE_ROUTER_ID=Z0
# ZONE_COUNT=12
# ZONE_FRACTAL_DEPTH=12
# PATTERN_CACHE_SIZE=10000
# PATTERN_HASH_ALGORITHM=sha256

# ---------------------------------------------------------------------------
# Zone MCP (codex-zone-mcp is owned by CodexIdentity and deployed separately)
# Note: the code default is MCP_ENABLED=true; set false explicitly if not deployed.
# ---------------------------------------------------------------------------
MCP_ENABLED=false
MCP_NODE_SERVER_URL=

# ---------------------------------------------------------------------------
# Page schema artifact / phase lock (optional)
# ---------------------------------------------------------------------------
PAGE_SCHEMA_ENABLED=false
PAGE_SCHEMA_ARTIFACT_PATH=
PAGE_SCHEMA_REQUIRE_VALID=true
PHASE_LOCK_ENABLED=false
PHASE_LOCK_HEADERS=false
