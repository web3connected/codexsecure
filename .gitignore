# --- Build output (root-anchored so cmd/server and internal/server stay tracked) ---
/bin/
/codexsecure
/codexsecure-api
/codexsecure-api-new
/codexsecure-static
/codexsecure_api
/server
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# --- Secrets and environment files (only .env.example is tracked) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.jwk

# --- Local databases, dumps and backups ---
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
*.bak
*.bak-*
*.tgz
*.tar.gz
backups/
pgdata/

# --- Go tooling ---
vendor/
go.work
go.work.sum

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs and temp ---
*.log
logs/
tmp/
temp/
